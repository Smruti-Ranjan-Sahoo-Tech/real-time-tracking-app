<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Realtime Tracking App</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
  />
  <style>
    #map {
      height: calc(100vh - 80px); /* Full screen minus header */
      width: 100%;
    }
  </style>
</head>
<body class="bg-gray-100">

  <!-- Header -->
  <header class="bg-blue-600 text-white p-4 shadow-md flex justify-between items-center">
    <h1 class="text-2xl font-bold">Realtime Tracking App</h1>
    <button
  class="bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold hover:bg-gray-100 transition"
  onclick="window.location.href='/'"
>
      Refresh
    </button>
  </header>

  <!-- Map Container -->
  <div id="map" class="shadow-lg rounded-lg mx-4 my-4"></div>

  <!-- Floating Info Card -->
  <div class="fixed bottom-5 right-5 bg-white p-4 rounded-lg shadow-lg w-72">
    <h2 class="font-bold text-lg text-gray-700 mb-2">Tracker Info</h2>
    <p class="text-gray-600 mb-1"><span class="font-semibold">Latitude:</span> <span id="lat">--</span></p>
    <p class="text-gray-600 mb-1"><span class="font-semibold">Longitude:</span> <span id="lng">--</span></p>
    <p class="text-gray-600"><span class="font-semibold">Speed:</span> <span id="speed">--</span> km/h</p>
  </div>

  <!-- Scripts -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
  <script src="/js/script.js"></script>

</body>
</html>

